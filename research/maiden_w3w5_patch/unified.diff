+        date_s = rec.get("kaisai_date") or rec.get("date")
+        if isinstance(date_s, str) and date_s[:4] in counts:
+            counts[date_s[:4]] += 1
+            continue
+        if isinstance(race_id, str) and race_id[:4] in counts:
+            counts[race_id[:4]] += 1
