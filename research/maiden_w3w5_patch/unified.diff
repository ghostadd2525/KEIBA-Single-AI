+        self.assertEqual(cfg.queue_path.read_bytes(), before)
+        applied = migrate.migrate(cfg.queue_path, apply=True)
+        self.assertEqual(applied["applied_count"], 3)
+        rows = w5_load_queue(cfg.queue_path)
