# =============================================================================
# development — ローカル（wrangler pages dev + ローカル Python）
# コピー先: リポジトリ直下 .dev.vars
# Tunnel / Access は通常使わない（127.0.0.1 直結）
# =============================================================================

EXPECT_ENV=development

# BFF → Python（ローカル直結）
AI_BASE_URL=http://127.0.0.1:8000
AI_API_KEY=

# Access Service Token（ローカルでは空）
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

AUTH_MODE=stub
VALIDATE_CONTRACTS=soft
KAOBA_PROVIDER=auto
AI_ENGINE=mock

# Python 側
AI_HOST=127.0.0.1
AI_PORT=8000
AI_ALLOW_PUBLIC_BIND=0
