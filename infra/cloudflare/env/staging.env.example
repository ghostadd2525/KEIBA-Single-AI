# =============================================================================
# staging — Cloudflare Pages (Preview/Staging) + Tunnel 上の Python
# 設定場所: Cloudflare Dashboard → Pages → Settings → Environment variables
#           （または wrangler pages secret put）
# =============================================================================

EXPECT_ENV=staging

# Tunnel 配下の Private / Access 保護ホスト（末尾スラッシュなし）
AI_BASE_URL=https://ai-staging.expect-internal.example.com

# Python と共有する共有鍵（任意だが staging 以降推奨）
AI_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Access Service Token（terraform output bff_access_client_*）
CF_ACCESS_CLIENT_ID=REPLACE
CF_ACCESS_CLIENT_SECRET=REPLACE

AUTH_MODE=stub
VALIDATE_CONTRACTS=soft
KAOBA_PROVIDER=auto
AI_ENGINE=real

# Python ホスト上のみ（Pages には不要）
# AI_HOST=127.0.0.1
# AI_PORT=8000
# AI_ALLOW_PUBLIC_BIND=0
# AI_API_KEY=（上記と同じ）
# TUNNEL_TOKEN=（terraform output tunnel_token）
