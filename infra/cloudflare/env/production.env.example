# =============================================================================
# production — Cloudflare Pages Production + Tunnel 上の Python
# =============================================================================

EXPECT_ENV=production

AI_BASE_URL=https://ai.expect-internal.example.com
PI_BASE_URL=https://pi.expect-internal.example.com
AI_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

CF_ACCESS_CLIENT_ID=REPLACE
CF_ACCESS_CLIENT_SECRET=REPLACE

AUTH_MODE=stub
# Version8.5.1: stub は本番ポリシー上禁止。移行完了まで一時ブレークグラスのみ:
ALLOW_STUB_AUTH=1
VALIDATE_CONTRACTS=soft
KAOBA_PROVIDER=auto
AI_ENGINE=real

# Version 9.0 Benchmark Layer — Production Standard（Pages [vars] と同期）
V9_BENCHMARK_LAYER=true

# Python ホスト: AI_HOST=127.0.0.1 / AI_ALLOW_PUBLIC_BIND=0 必須
#
# Conversation V5（Python expect-ai 側 · Pages には不要）:
#   cp infra/aws/systemd/conversation.env.example → /etc/expect-ai/conversation.env
#   expect-ai.service に EnvironmentFile=-/etc/expect-ai/conversation.env を追加
#   詳細: docs/releases/v5-production-rollout-report.md
