[Unit]
Description=Expect Result Automation (OPS-ResultAutomation)
After=network-online.target expect-ai.service
Wants=network-online.target

[Service]
Type=oneshot
User=expect
Group=expect
WorkingDirectory=/opt/expect-ai/current/services/win5-ai
EnvironmentFile=-/etc/expect-ai/result-automation.env
Environment=EXPECT_RA_AUTO_MODE=all
ExecStart=/usr/bin/python3 -m app.ops.result_automation_runner --mode auto

[Install]
WantedBy=multi-user.target
