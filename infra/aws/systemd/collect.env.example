# /etc/expect-ai/collect.env — Collector weekday production
# cp infra/aws/systemd/collect.env.example → /etc/expect-ai/collect.env

# KeibaNet API（必須 — O-1 検証済み URL）
EXPECT_KEIBANET_BASE_URL=https://REPLACE_WITH_KEIBANET_HOST

# PI 接続制限（SoT: CollectBudget、上限 200）
EXPECT_COLLECT_DAILY_LIMIT=200

# KeibaNet クライアント
EXPECT_KEIBANET_TIMEOUT=30
EXPECT_KEIBANET_MAX_RETRIES=3
EXPECT_KEIBANET_MIN_INTERVAL_SEC=1.0

# 永続化パス（本番 EC2 — ubuntu@KEIBA-Single-AI レイアウト）
EXPECT_AI_DB_PATH=/home/ubuntu/KEIBA-Single-AI/services/win5-ai/var/expect_ai.db
EXPECT_COLLECT_MANIFEST_DIR=/home/ubuntu/KEIBA-Single-AI/services/win5-ai/var/collect/manifests
EXPECT_COLLECT_RAW_DIR=/home/ubuntu/KEIBA-Single-AI/services/win5-ai/var/collect/raw
EXPECT_COLLECT_COVERAGE_DIR=/home/ubuntu/KEIBA-Single-AI/services/win5-ai/var/collect/coverage
EXPECT_COLLECT_CALENDAR_DIR=/home/ubuntu/KEIBA-Single-AI/config/collect-calendars

# 枠順確定後（entries_core）— 1/true で強制、未設定時は木曜以降自動
# EXPECT_COLLECT_DRAW_CONFIRMED=1

# Prediction Core（expect-ai.service と共有）
AI_PLATFORM_ROOT=/opt/expect-ai/platform
AI_ENGINE=real
