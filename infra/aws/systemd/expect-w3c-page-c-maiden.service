# /etc/systemd/system/expect-w3c-page-c-maiden.service
# DO NOT enable/start until Owner approves after bounded live validation.
[Unit]
Description=Expect W3-C Shadow — Shared PAGE-C bounded maiden result acquisition (Research only)
After=network-online.target expect-pi-race-refresh.service expect-w2-haron-shadow.service expect-c4-page-a1-calendar.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/KEIBA-Single-AI/services/pi-keibanet-api
Environment=PI_DATA_ROOT=/opt/expect-ai/platform/data
Environment=PI_RACE_REFRESH_STATE_ROOT=/opt/expect-ai/platform/data/var/race_refresh
Environment=W3_ROOT=/opt/expect-ai/platform/data/var/w3_maiden
Environment=W3C_ENABLED=1
Environment=W3C_MAX_RACES_PER_RUN=2
Environment=W3C_MAX_REQUESTS_PER_RUN=2
Environment=W3C_MAX_RUNTIME_SEC=120
Environment=W3C_MAX_CONSECUTIVE_FAILURES=3
Environment=W3C_STOP_ON_BLOCK=1
Environment=W3C_COOLDOWN_SECONDS=86400
Environment=W3C_MIN_INTERVAL_SEC=1.0
# Rollback: W3C_ENABLED=0 or systemctl disable --now expect-w3c-page-c-maiden.timer
ExecStart=/usr/bin/python3 scripts/w3_maiden_page_c_acquire_run.py

[Install]
WantedBy=multi-user.target
