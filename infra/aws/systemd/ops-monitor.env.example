# Expect OPS Monitor — EC2 environment
# /etc/expect-ai/ops-monitor.env

EXPECT_OPS_ROOT=/var/lib/expect-ai/ops
PYTHON_HEALTH_URL=http://127.0.0.1:8000/health

# Version 2 Operations Phase 1 — PI probe (PI-H01/H02/H03)
PI_HEALTH_URL=http://127.0.0.1:8081/health
PI_SYSTEMD_UNIT=expect-pi-keibanet-api
# Optional: Tunnel 経由 PI 到達（未設定時は skip）
# PI_TUNNEL_PROBE_URL=https://ai.expect-keiba.com/health

# Tunnel 経由到達性（Pages BFF と同経路）
# AI_TUNNEL_HEALTH_URL=https://ai.example.com/health
# BFF 統合監視（Pages 本番 URL）
# BFF_MONITOR_URL=https://expect.example.com/api/ops/monitor
# OPS_MONITOR_KEY=

# SLK-N01 Critical / SLK-N02 Warning（未設定時は no-op）
# OPS_SLACK_WEBHOOK_URL=
# OPS_SLACK_WEBHOOK_CRITICAL=
# OPS_SLACK_WEBHOOK_WARNING=
