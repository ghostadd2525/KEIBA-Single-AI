[Unit]
Description=Expect Result Automation Timer (Version7.3 race-day cadence)
Requires=expect-result-automation.service

[Timer]
# Version7.3: 2 分 tick。runner 側 cadence が idle/stop なら即 skip
OnCalendar=*-*-* *:0/2:00
AccuracySec=30s
Persistent=true
Unit=expect-result-automation.service

[Install]
WantedBy=timers.target
