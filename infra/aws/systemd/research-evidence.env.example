# /etc/expect-ai/research-evidence.env
# Research Evidence Collector (Version10) — EC2

RESEARCH_EVIDENCE_COLLECTOR=1
RESEARCH_HARVEST_ASOF=1
RESEARCH_COLLECTOR_POLL_SEC=30
RESEARCH_COLLECTOR_MAX_ATTEMPTS=5
RESEARCH_COLLECTOR_DEADLINE_MIN=15
RESEARCH_PI_TIMEOUT_SEC=30

# PI (local)
PI_BASE_URL=http://127.0.0.1:8081
EXPECT_KEIBANET_BASE_URL=http://127.0.0.1:8081
EXPECT_PI_BASE_URL=http://127.0.0.1:8081

# Same DB as expect-ai
EXPECT_AI_DB_PATH=/home/ubuntu/KEIBA-Single-AI/services/win5-ai/var/expect_ai.db

# JSON store
RESEARCH_EVIDENCE_ROOT=/home/ubuntu/KEIBA-Single-AI/evidence/research
