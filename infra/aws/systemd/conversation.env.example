# =============================================================================
# Expect Conversation — Version 5 Production Flags
# Install:  /etc/expect-ai/conversation.env
# Wire:     EnvironmentFile=-/etc/expect-ai/conversation.env
#           on expect-ai.service (after shared/.env)
#
# Code defaults remain OFF (ADR-005). Production turns Canonical path ON via env.
# Prediction AI / Ranking / Confidence / Purchase は本ファイルで変更しない。
# Security Guard はコード常時有効（Flag で OFF 不可 · ADR-001）。
# Memory Platform（V6 Phase 2）— 既定 OFF。ON 時のみ Consent「覚えて」で長期保存。
# F_V6_MEMORY=OFF
# =============================================================================

# --- Platform master ---
F_V4_CONVERSATION_ENABLED=ON

# --- Agents ---
F_V4_REVIEW_AGENT=ON
F_V4_PERSONAL_CHAT=ON

# --- Tool / Knowledge (Canonical · ADR-002 / V5 Runtime) ---
F_V4_TOOL_LAYER=ON
F_V4_KNOWLEDGE_LAYER=ON
F_V5_KNOWLEDGE_RUNTIME=ON

# --- Legacy / deferred ---
F_V4_KNOWLEDGE_INTEGRATION=OFF

# --- V6 Memory Platform（Consent-only · 既定 OFF · 自動保存禁止）---
F_V6_MEMORY=OFF

# --- LLM（Personal Chat / Review の自然会話）---
# EC2 上で Ollama が listen していること（既定 http://127.0.0.1:11434）
F_V4_CONVERSATION_OLLAMA=ON
CONVERSATION_OLLAMA_BASE_URL=http://127.0.0.1:11434
# t3.small (~2GiB): qwen2.5:1.5b / メモリ増強後: qwen3:8b
CONVERSATION_DEFAULT_MODEL=qwen2.5:1.5b
CONVERSATION_OLLAMA_TIMEOUT_MS=45000
