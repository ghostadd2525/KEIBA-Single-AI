# /etc/systemd/system/expect-w5-maiden-history.service
# Owner-approved Research historical maiden horse-history (lowest priority).
[Unit]
Description=Expect W5 Research — Bounded historical maiden horse-history acquisition
After=network-online.target expect-pi-race-refresh.service expect-w2-haron-shadow.service expect-c4-page-a1-calendar.service expect-w3c-page-c-maiden.service expect-w4-horse-d1d2.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/KEIBA-Single-AI/services/pi-keibanet-api
Environment=PI_DATA_ROOT=/opt/expect-ai/platform/data
Environment=W3_ROOT=/opt/expect-ai/platform/data/var/w3_maiden
Environment=W5_ROOT=/opt/expect-ai/platform/data/var/w5_maiden_history
Environment=W5_ENABLED=1
Environment=W5_FETCH_ENABLED=1
Environment=W5_MAX_HORSES_PER_RUN=2
Environment=W5_MAX_REQUESTS_PER_RUN=4
Environment=W5_MAX_RUNTIME_SEC=120
Environment=W5_MAX_CONSECUTIVE_FAILURES=3
Environment=W5_STOP_ON_BLOCK=1
Environment=W5_COOLDOWN_SECONDS=86400
Environment=W5_MIN_INTERVAL_SEC=1.0
Environment=W5_W2_UNIT=expect-w2-haron-shadow.service
Environment=W5_C4_UNIT=expect-c4-page-a1-calendar.service
Environment=W5_W3C_UNIT=expect-w3c-page-c-maiden.service
Environment=W5_W4_UNIT=expect-w4-horse-d1d2.service
# Rollback: W5_ENABLED=0 or systemctl disable --now expect-w5-maiden-history.timer
ExecStart=/usr/bin/python3 scripts/w5_maiden_history_acquire_run.py

[Install]
WantedBy=multi-user.target
