# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Node
node_modules/
npm-debug.log*
.wrangler/
.dev.vars
.wrangler-functions-build/
# NOTE: functions/ は Pages BFF 本体。絶対に ignore しないこと。

# Build/temp
dist/
.cache/
*.log
tmp-*

# β監査ログ（JSONL）。ディレクトリ自体は残す
logs/audit/*.jsonl

# OPS-Monitor 実行時ログ（EC2 / ローカル）
var/ops/
var/ops-dev/

# Production Miss Evidence 作業領域（Git 同期先は evidence/miss/）
services/win5-ai/var/miss-evidence/*/
!services/win5-ai/var/miss-evidence/.gitignore
services/win5-ai/var/improvement-evidence/

# PI runtime / debug artifacts
services/pi-keibanet-api/var/
services/pi-keibanet-api/**/__pycache__/

# Ephemeral development run artifacts (keep index/proposals separately if needed)
development/runs/
development/canary/results/**/2026-*.json
docs/ops/canary-v1.1-evidence/tmp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
