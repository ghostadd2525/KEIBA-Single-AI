# Version 5 — Production Configuration (Conversation)
# Canonical copy for ops / CI. Deploy as /etc/expect-ai/conversation.env
# See: infra/aws/systemd/conversation.env.example
#      docs/releases/v5-production-rollout-report.md

F_V4_CONVERSATION_ENABLED=ON
F_V4_REVIEW_AGENT=ON
F_V4_PERSONAL_CHAT=ON
F_V4_TOOL_LAYER=ON
F_V4_KNOWLEDGE_LAYER=ON
F_V5_KNOWLEDGE_RUNTIME=ON
F_V4_KNOWLEDGE_INTEGRATION=OFF
# Personal Chat / Review の自然会話に必要（Ollama が EC2 で起動していること）
F_V4_CONVERSATION_OLLAMA=ON
CONVERSATION_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EC2 t3.small (~2GiB) 向け既定。メモリ増強後は qwen3:8b に上げてよい。
CONVERSATION_DEFAULT_MODEL=qwen2.5:1.5b
CONVERSATION_OLLAMA_TIMEOUT_MS=45000
