{
  "name": "keiba-single-ai",
  "private": true,
  "description": "Expect KEIBA AI — Cloudflare Pages UI + Functions BFF",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2026-07-19",
    "dev:ai": "wrangler pages dev public --compatibility-date=2026-07-19 --binding AI_BASE_URL=http://127.0.0.1:8000 --binding PI_BASE_URL=http://127.0.0.1:8081",
    "ai": "python services/win5-ai/run.py",
    "monitor:dev": "node scripts/ops/monitor-dev.mjs",
    "monitor:prod": "node scripts/ops/monitor-prod.mjs",
    "evidence:sync": "node scripts/ops/sync-miss-evidence.mjs",
    "result:auto": "cd services/win5-ai && python -m app.ops.result_automation_runner --mode auto",
    "validate:bundle": "node scripts/validate-fixtures.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "check:auth:prod": "node scripts/ops/check-production-auth.mjs",
    "check:auth:prod:example": "node scripts/ops/check-production-auth.mjs --env-file infra/cloudflare/env/production.env.example",
    "deploy:pages": "node scripts/ops/block-direct-pages-deploy.mjs",
    "deploy:pages:raw": "node scripts/ops/require-deploy-override.mjs && npm run check:auth:prod && wrangler pages deploy public --project-name=keiba-single-ai --branch=main --commit-dirty=true",
    "deploy:pages:gate": "node scripts/ops/pages-deploy-gate.mjs",
    "deploy:pages:safe": "npm run deploy:pages:gate && node scripts/ops/deploy-pages-after-gate.mjs",
    "test:auth-guard": "node --test tests/unit/production-auth-guard.test.mjs",
    "beta": "node scripts/beta-admin.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:snapshot": "node --test tests/bff/snapshots.test.mjs",
    "test:ops": "cd services/win5-ai && python -m unittest discover -s tests/ops -p test_*.py -v",
    "test": "node --test tests/contract/*.test.mjs tests/bff/snapshots.test.mjs",
    "test:race-catalog": "node --test tests/contract/race-catalog.test.mjs",
    "test:monitor": "node --test tests/contract/ops-monitor.test.mjs",
    "test:ops1a": "node --test tests/contract/ops-1a-admin-bypass.test.mjs",
    "improve:cycle": "node scripts/ops/improvement/run-cycle.mjs",
    "improve:index": "node scripts/ops/improvement/index-evidence.mjs",
    "improve:analyze": "node scripts/ops/improvement/analyze-evidence.mjs",
    "improve:propose": "node scripts/ops/improvement/propose-evidence.mjs",
    "improve:canary": "node scripts/ops/improvement/canary-evidence.mjs",
    "improve:rc": "node scripts/ops/improvement/rc-evidence.mjs",
    "test:improve:i4": "node --test tests/contract/improve-i4-canary.test.mjs",
    "test:improve:i5": "node --test tests/contract/improve-i5-rc.test.mjs",
    "test:improve": "node --test tests/contract/ai-core-cycle.test.mjs",
    "test:improve:i1": "node --test tests/contract/improve-i1-index.test.mjs",
    "test:improve:i2": "node --test tests/contract/improve-i2-analyzer.test.mjs",
    "test:improve:i3": "node --test tests/contract/improve-i3-proposal.test.mjs",
    "v8:week-id": "node scripts/ops/v8/week-id.mjs",
    "v8:mon": "node scripts/ops/v8/run-day.mjs --day mon",
    "v8:tue": "node scripts/ops/v8/run-day.mjs --day tue",
    "v8:wed": "node scripts/ops/v8/run-day.mjs --day wed",
    "v8:thu": "node scripts/ops/v8/run-day.mjs --day thu",
    "v8:fri": "node scripts/ops/v8/run-day.mjs --day fri",
    "v8:week": "node scripts/ops/v8/run-day.mjs --day week",
    "v8:sat-deploy": "node scripts/ops/v8/run-day.mjs --day sat-deploy",
    "v8:baseline": "node scripts/ops/v8/baseline-285r.mjs",
    "v8:decide": "node scripts/ops/v8/decide.mjs",
    "v8:pattern": "node scripts/ops/v8/pattern-detect.mjs",
    "v8:rank": "node scripts/ops/v8/rank-proposals.mjs",
    "v8:validate": "node scripts/ops/v8/proposal-validate.mjs",
    "v8:canary-ranked": "node scripts/ops/v8/canary-ranked.mjs",
    "v8:metrics": "node scripts/ops/v8/research-metrics.mjs",
    "v8:history": "node scripts/ops/v8/weekly-history.mjs",
    "v8:feedback": "node scripts/ops/v8/analyzer-feedback.mjs",
    "v8:knowledge": "node scripts/ops/v8/knowledge-base.mjs",
    "v8:governance": "node scripts/ops/v8/governance.mjs",
    "v8:report": "node scripts/ops/v8/weekly-report.mjs",
    "v8:incident": "node scripts/ops/v8/incident-report.mjs",
    "v8:runner": "node scripts/ops/v8/runner.mjs",
    "v8:publish": "node scripts/ops/v8/publish-ops-snapshot.mjs",
    "v8:approval-expire": "node scripts/ops/v8/approval-queue.mjs --expire",
    "v8:approval-list": "node scripts/ops/v8/approval-queue.mjs --list",
    "v8:smoke88": "node --test tests/unit/v88-approval-queue.test.mjs",
    "v8:smoke881": "node --test tests/unit/v881-publish-layer.test.mjs",
    "v8:smoke86": "node --test tests/unit/v86-research-scheduler.test.mjs",
    "v8:smoke-ops": "node --test tests/unit/v8-weekly-ops-report.test.mjs",
    "v8:smoke": "node --test tests/unit/v8-self-improvement.test.mjs",
    "v8:smoke81": "node --test tests/unit/v81-analyzer.test.mjs",
    "v8:smoke82": "node --test tests/unit/v82-proposal-validation.test.mjs",
    "v8:smoke83": "node --test tests/unit/v83-analyzer-feedback.test.mjs",
    "v8:smoke84": "node --test tests/unit/v84-knowledge-base.test.mjs",
    "v8:smoke85": "node --test tests/unit/v85-governance.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
