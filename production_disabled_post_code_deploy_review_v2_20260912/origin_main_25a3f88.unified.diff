+def ensure_fake_ai_platform() -> Path:
+    root = str(FAKE_PLATFORM_ROOT)
+    os.environ["AI_PLATFORM_ROOT"] = root
+    if root in sys.path:
+        sys.path.remove(root)
+    sys.path.insert(0, root)
