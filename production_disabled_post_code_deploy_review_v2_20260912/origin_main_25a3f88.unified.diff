+def _raw_post_prediction_run(
+    host: str,
+    port: int,
+    body: bytes,
+    *,
+    extra_headers: dict[str, str] | None = None,
+) -> tuple[int, dict]:
+    headers = {
+        "Host": "%s:%s" % (host, port),
+        "Content-Type": "application/json; charset=utf-8",
+        "X-Prediction-Run-Key": "test-run-key",
+        "Connection": "close",
+    }
+    if extra_headers:
+        headers.update(extra_headers)
