{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expect.keiba/contracts/expect-improvement-proposal/1.0/schema.json",
  "title": "ImprovementProposal",
  "description": "Development 改善提案（設計書メタ）。コード・パッチは含めない。Lifecycle: expect-proposal-lifecycle/1.0. Analyzer confidence is advisory only — never sole accept/reject criterion. additionalProperties allowed for forward-compatible extensions (e.g. metadata).",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "status",
    "event_types",
    "evidence_refs",
    "purpose",
    "target",
    "expected_effect",
    "side_effects",
    "evaluation_method",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "expect-improvement-proposal/1.0" },
    "proposal_id": {
      "type": "string",
      "pattern": "^IMP-[0-9]{8}-[a-z0-9_]+-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "UNDER_REVIEW",
        "APPROVED",
        "CANARY_RUNNING",
        "CANARY_PASS",
        "CANARY_FAIL",
        "RC_CREATED",
        "DEPLOYED",
        "REJECTED",
        "ARCHIVED"
      ],
      "description": "Proposal Lifecycle status (expect-proposal-lifecycle/1.0)"
    },
    "lifecycle": {
      "type": "object",
      "description": "Optional embedded lifecycle record with history (expect-proposal-lifecycle/1.0)"
    },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fingerprints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "description": "Required: Proposal must cite grounding Evidence for traceability",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type", "path"],
        "additionalProperties": true,
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "event_type": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Repo-relative path e.g. evidence/improvement/miss/YYYY-MM-DD/{file}.json"
          },
          "race_date": { "type": ["string", "null"] },
          "race_id": { "type": ["string", "null"] },
          "fingerprint": { "type": ["string", "null"] },
          "cluster_id": { "type": ["string", "null"] }
        }
      }
    },
    "purpose": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "expected_effect": { "type": "string", "minLength": 1 },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evaluation_method": { "type": "string", "minLength": 1 },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "analysis_refs": {
      "type": "array",
      "description": "References to Analyzer (expect-root-cause/1.0) outputs. Prefer structured objects; string paths remain readable for older artifacts.",
      "items": {
        "type": "object",
        "required": ["analysis_id", "event_type", "path"],
        "additionalProperties": true,
        "properties": {
          "analysis_id": { "type": "string", "minLength": 1 },
          "event_type": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Repo-relative path under development/analysis/"
          },
          "root_cause": { "type": ["string", "null"] },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "Copied from Analyzer for context. Advisory only — not an accept/reject gate."
          },
          "reason": { "type": ["string", "null"] },
          "schema_version": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Forward-compatible extension bag (I-3+). Must not encode sole confidence-based acceptance.",
      "additionalProperties": true
    },
    "code_artifacts": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] }
  }
}
