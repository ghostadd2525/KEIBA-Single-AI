{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expect.keiba/contracts/expect-root-cause-taxonomy/1.0/schema.json",
  "title": "RootCauseTaxonomy",
  "description": "Version8 Research Root Cause families. Complements miss_top1|3|5. Production miss schema enum is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "families"],
  "properties": {
    "schema_version": { "const": "expect-root-cause-taxonomy/1.0" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "candidate_pool",
              "repick",
              "delete",
              "purchase",
              "confidence",
              "world",
              "subworld",
              "ranking",
              "features",
              "ops_data",
              "unknown"
            ]
          },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "related_miss_categories": {
            "type": "array",
            "items": { "type": "string", "enum": ["miss_top1", "miss_top3", "miss_top5"] }
          },
          "analyzer_hints": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
